# MediPriority Environment Variables Example
# Copy this file to application-local.yml in the backend and fill in real values.
# NEVER commit a file containing real credentials.

# Database
DB_URL=jdbc:mysql://localhost:3306/medipriority_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=medipriority_user
DB_PASSWORD=YourSecurePassword123!

# JWT
JWT_SECRET=replace-this-with-a-256-bit-random-secret-string-for-production
JWT_EXPIRATION_MS=86400000

# Server
SERVER_PORT=8080

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api

# CORS allowed origin
CORS_ALLOWED_ORIGIN=http://localhost:5173
